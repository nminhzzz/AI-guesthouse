ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================
# COOKIES — set COOKIE_SECURE=true and COOKIE_SAMESITE=strict in production
# ============================================================
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ============================================================
# CLOUDINARY
# ============================================================
CLOUDINARY_CLOUD_NAME=dddtt5bdd
CLOUDINARY_API_KEY=989474998462384
